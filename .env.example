DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"

# Only needed if DATABASE_URL is a pooled connection (e.g. Neon's "-pooler" host).
# Same connection string, with "-pooler" removed from the hostname.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

NEXTAUTH_SECRET="replace-with-a-random-string"
NEXTAUTH_URL="http://localhost:3000"
